# =====================================================
# Unity 6.0 .gitignore
# =====================================================
 
# -------------------------------
# OS-specific files
# -------------------------------
.DS_Store
Thumbs.db
desktop.ini
 
# -------------------------------
# Unity core generated folders
# -------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
sysinfo.txt
 
# -------------------------------
# Unity 6 cache and build system
# -------------------------------
[Bb]ee/
[Aa]rtifacts/
[Bb]urstCache/
[Ll]ibrary/Artifacts/
[Ll]ibrary/GICache/
[Ll]ibrary/ShaderCache/
 
# -------------------------------
# Project files (auto-generated)
# -------------------------------
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.DotSettings.user
 
# -------------------------------
# IDE-specific
# -------------------------------
.vscode/
.idea/
 
# -------------------------------
# Version control systems
# -------------------------------
.collab/
.PlasticSCM/
 
# -------------------------------
# XR / AR generated data
# -------------------------------
[Xx]RCache/
[Aa]RCache/
 
# -------------------------------
# Build outputs
# -------------------------------
[Bb]uilds/
[Bb]undles/
StreamingAssets/AssetBundles/
*.apk
*.aab
*.ipa
*.exe
*.app
*.unitypackage
*.xcodeproj/
*.xcworkspace/
 
# -------------------------------
# Platform-specific exports
# -------------------------------
ExportedObj/
*.unitypackage
 
# -------------------------------
# Addressables
# -------------------------------
[Aa]ddressableAssetsData/
[Aa]ddressablesBuildTEmp/
[Aa]ddressablesLinkData/
[Aa]ddressablesBuildArtifacts/
 
# -------------------------------
# Crash, profiling, test data
# -------------------------------
*.stacktrace
*.crash
*.dmp
[Tt]estResults/
[Cc]overageResults/
 
# -------------------------------
# Unity Cloud Build
# -------------------------------
[Uu]nityCloud/
[Uu]nityBuildReports/
 
# -------------------------------
# Package Manager
# -------------------------------
[Pp]ackages/com.unity.package-manager/manifest.json.backup
[Pp]ackages/packages-lock.json.backup
 
# -------------------------------
# Logs, temp, backups
# -------------------------------
*.log
*.bak
*.tmp
 
# -------------------------------
# Temporary user files
# -------------------------------
*.swp
*.swm
*.swn
*.swo
 
# =====================================================
# Important project folders to KEEP in Git
# =====================================================
!Assets/
!Packages/
!ProjectSettings/
!UserSettings/EditorUserSettings.asset
!ProjectSettings/ProjectVersion.txt
